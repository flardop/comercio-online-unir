{
  "name": "plataforma-segunda-mano",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run start --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspace backend",
    "check": "npm run build --workspace frontend && npm run test --workspace backend",
    "db:up": "docker compose up -d database",
    "db:down": "docker compose down"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}

